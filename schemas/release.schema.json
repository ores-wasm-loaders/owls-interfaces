{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ores.dev/wasm-loaders/release/v2",
  "$ref": "Release.json",
  "$defs": {
    "Asset": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Asset.json",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "anyOf": [
            { "type": "string", "const": "wasm" },
            { "type": "string", "const": "module" },
            { "type": "string", "const": "script" },
            { "type": "string", "const": "data" },
            { "type": "string", "const": "font" }
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prepare": { "type": "boolean" },
        "role": {
          "anyOf": [
            { "type": "string", "const": "bootstrap" },
            { "type": "string", "const": "glue" },
            { "type": "string", "const": "module" },
            { "type": "string", "const": "fallback" },
            { "type": "string", "const": "chunk" },
            { "type": "string", "const": "asset" }
          ]
        },
        "stage": {
          "anyOf": [
            { "type": "string", "const": "critical" },
            { "type": "string", "const": "optional" },
            { "type": "string", "const": "lazy" }
          ]
        }
      },
      "required": ["id", "url", "kind", "bytes", "sha256", "prepare"],
      "unevaluatedProperties": false
    },
    "PrepareBudget": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PrepareBudget.json",
      "type": "object",
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "furthestStage": {
          "anyOf": [
            { "type": "string", "const": "fetch" },
            { "type": "string", "const": "compile" }
          ]
        }
      },
      "required": ["maxBytes", "maxConcurrency", "furthestStage"],
      "unevaluatedProperties": false
    },
    "Activation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Activation.json",
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            { "type": "string", "const": "attach-view" },
            { "type": "string", "const": "hydrate-islands" },
            { "type": "string", "const": "mount-route" },
            { "type": "string", "const": "run-app" }
          ]
        },
        "hostSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "islands": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 256
        },
        "routes": { "$ref": "RecordString.json" }
      },
      "required": ["mode"],
      "unevaluatedProperties": false
    },
    "RecordString": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordString.json",
      "type": "object",
      "properties": {},
      "unevaluatedProperties": { "type": "string" }
    },
    "Release": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Release.json",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "anyOf": [
            { "type": "number", "const": 1 },
            { "type": "number", "const": 2 }
          ]
        },
        "appId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._+-]+$"
        },
        "runtime": {
          "anyOf": [
            { "type": "string", "const": "raw-wasm" },
            { "type": "string", "const": "wasm-bindgen" },
            { "type": "string", "const": "flutter-web" }
          ]
        },
        "framework": {
          "anyOf": [
            { "type": "string", "const": "leptos" },
            { "type": "string", "const": "dioxus" },
            { "type": "string", "const": "flutter" },
            { "type": "string", "const": "none" }
          ]
        },
        "toolchain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "requiresCrossOriginIsolation": { "type": "boolean" },
        "assets": {
          "type": "array",
          "items": { "$ref": "Asset.json" },
          "minItems": 1,
          "maxItems": 512
        },
        "prepareBudget": { "$ref": "PrepareBudget.json" },
        "activation": { "$ref": "Activation.json" },
        "extensions": { "$ref": "RecordUnknown.json" }
      },
      "required": ["schemaVersion", "appId", "release", "runtime", "entrypoint", "assets"],
      "unevaluatedProperties": false
    },
    "RecordUnknown": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordUnknown.json",
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {}
    }
  }
}
