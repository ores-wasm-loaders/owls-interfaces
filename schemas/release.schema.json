{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ores-wasm-loaders.dev/release-v2.json",
  "title": "OWLS release manifest",
  "description": "Independent JSON Schema authority for immutable OWLS release manifests. TypeSpec is a peer authority; generated output is comparison evidence only.",
  "$ref": "#/$defs/Release",
  "$defs": {
    "SchemaVersion": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SchemaVersion",
      "type": "number",
      "enum": [
        1,
        2
      ]
    },
    "RuntimeKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RuntimeKind",
      "type": "string",
      "enum": [
        "raw-wasm",
        "wasm-bindgen",
        "flutter-web"
      ]
    },
    "FrameworkKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FrameworkKind",
      "type": "string",
      "enum": [
        "leptos",
        "dioxus",
        "flutter",
        "none"
      ]
    },
    "AssetKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "AssetKind",
      "type": "string",
      "enum": [
        "wasm",
        "module",
        "script",
        "data",
        "font"
      ]
    },
    "AssetRole": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "AssetRole",
      "type": "string",
      "enum": [
        "bootstrap",
        "glue",
        "module",
        "fallback",
        "chunk",
        "asset"
      ]
    },
    "AssetStage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "AssetStage",
      "type": "string",
      "enum": [
        "critical",
        "optional",
        "lazy"
      ]
    },
    "PrepareStage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PrepareStage",
      "type": "string",
      "enum": [
        "fetch",
        "compile"
      ]
    },
    "ActivationMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ActivationMode",
      "type": "string",
      "enum": [
        "attach-view",
        "hydrate-islands",
        "mount-route",
        "run-app"
      ]
    },
    "AssetId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "AssetId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "HttpsAssetUrl": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "HttpsAssetUrl",
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 4096
    },
    "Sha256Hex": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Sha256Hex",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ApplicationId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ApplicationId",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "ReleaseId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ReleaseId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "ToolchainId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ToolchainId",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "HostSelector": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "HostSelector",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "IslandName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "IslandName",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "RecordString": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordString",
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "string"
      }
    },
    "RecordUnknown": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordUnknown",
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {}
    },
    "Asset": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Asset",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "AssetId"
        },
        "url": {
          "$ref": "HttpsAssetUrl"
        },
        "kind": {
          "$ref": "AssetKind"
        },
        "role": {
          "$ref": "AssetRole"
        },
        "stage": {
          "$ref": "AssetStage"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "$ref": "Sha256Hex"
        },
        "prepare": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "url",
        "kind",
        "bytes",
        "sha256",
        "prepare"
      ],
      "unevaluatedProperties": false
    },
    "PrepareBudget": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PrepareBudget",
      "type": "object",
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "furthestStage": {
          "$ref": "PrepareStage"
        }
      },
      "required": [
        "maxBytes",
        "maxConcurrency",
        "furthestStage"
      ],
      "unevaluatedProperties": false
    },
    "Activation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Activation",
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "ActivationMode"
        },
        "hostSelector": {
          "$ref": "HostSelector"
        },
        "islands": {
          "type": "array",
          "items": {
            "$ref": "IslandName"
          },
          "maxItems": 256
        },
        "routes": {
          "$ref": "RecordString"
        }
      },
      "required": [
        "mode"
      ],
      "unevaluatedProperties": false
    },
    "Release": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Release",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "SchemaVersion"
        },
        "appId": {
          "$ref": "ApplicationId"
        },
        "release": {
          "$ref": "ReleaseId"
        },
        "runtime": {
          "$ref": "RuntimeKind"
        },
        "framework": {
          "$ref": "FrameworkKind"
        },
        "toolchain": {
          "$ref": "ToolchainId"
        },
        "entrypoint": {
          "$ref": "EntrypointId"
        },
        "requiresCrossOriginIsolation": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "Asset"
          },
          "minItems": 1,
          "maxItems": 512
        },
        "prepareBudget": {
          "$ref": "PrepareBudget"
        },
        "activation": {
          "$ref": "Activation"
        },
        "extensions": {
          "$ref": "RecordUnknown"
        }
      },
      "required": [
        "schemaVersion",
        "appId",
        "release",
        "runtime",
        "entrypoint",
        "assets"
      ],
      "unevaluatedProperties": false
    },
    "EntrypointId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EntrypointId",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
